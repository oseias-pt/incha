# Normalise line endings in the repository regardless of contributor platform.
# Without this, core.autocrlf decides per-machine and the same file lands as
# LF for one contributor and CRLF for the next, producing whole-file diffs.

* text=auto eol=lf

# Shell scripts and CI workflows run on Linux runners. CRLF makes a script
# fail with "bad interpreter" and is silently accepted by nothing useful, so
# pin them even if a contributor's editor prefers otherwise.
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Lua sources: ESO tolerates either ending, but pinning keeps diffs readable.
*.lua       text eol=lf
*.txt       text eol=lf
*.md        text eol=lf

# DDS textures are binary; never touch them.
*.dds       binary
