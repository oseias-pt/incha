<GuiXml>
  <Controls>
    <!--
      InchPanel — Incha trial overlay.
      Defined in XML so ESO creates controls during the loading sequence.
      Font, colour, and alignment are applied in Panel.lua build() via Lua API
      (inline XML attributes for those properties are not reliably supported
      across ESO XML parser versions and cause silent element-creation failures).
    -->
    <TopLevelControl name="InchPanel" hidden="true"
                     clampedToScreen="true" movable="true" mouseEnabled="true">
      <Dimensions x="320" y="260"/>
      <!-- initial anchor is overridden by applyPosition() in Panel.lua -->
      <Anchor point="TOPLEFT" relativeTo="GuiRoot" relativePoint="TOPLEFT"
              offsetX="800" offsetY="150"/>

      <Controls>
        <!-- semi-transparent dark background -->
        <Backdrop name="$(parent)Bg">
          <AnchorFill/>
          <Edge edgeTexture="" edgeSize="8" tileCorner="false" tileEdge="false"/>
          <Center centerTexture=""/>
          <BackgroundColor r="0.04" g="0.04" b="0.04" a="0.82"/>
          <EdgeColor r="0.35" g="0.35" b="0.35" a="0.9"/>
        </Backdrop>

        <!-- header: boss name / HM status -->
        <Label name="$(parent)Header">
          <Dimensions x="304" y="18"/>
          <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT"
                  offsetX="8" offsetY="8"/>
        </Label>

        <!-- info lines 1–10: timer countdowns (18 px pitch) -->
        <Label name="$(parent)Info01">
          <Dimensions x="304" y="16"/>
          <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT"
                  offsetX="8" offsetY="28"/>
        </Label>
        <Label name="$(parent)Info02">
          <Dimensions x="304" y="16"/>
          <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT"
                  offsetX="8" offsetY="46"/>
        </Label>
        <Label name="$(parent)Info03">
          <Dimensions x="304" y="16"/>
          <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT"
                  offsetX="8" offsetY="64"/>
        </Label>
        <Label name="$(parent)Info04">
          <Dimensions x="304" y="16"/>
          <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT"
                  offsetX="8" offsetY="82"/>
        </Label>
        <Label name="$(parent)Info05">
          <Dimensions x="304" y="16"/>
          <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT"
                  offsetX="8" offsetY="100"/>
        </Label>
        <Label name="$(parent)Info06">
          <Dimensions x="304" y="16"/>
          <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT"
                  offsetX="8" offsetY="118"/>
        </Label>
        <Label name="$(parent)Info07">
          <Dimensions x="304" y="16"/>
          <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT"
                  offsetX="8" offsetY="136"/>
        </Label>
        <Label name="$(parent)Info08">
          <Dimensions x="304" y="16"/>
          <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT"
                  offsetX="8" offsetY="154"/>
        </Label>
        <Label name="$(parent)Info09">
          <Dimensions x="304" y="16"/>
          <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT"
                  offsetX="8" offsetY="172"/>
        </Label>
        <Label name="$(parent)Info10">
          <Dimensions x="304" y="16"/>
          <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT"
                  offsetX="8" offsetY="190"/>
        </Label>

        <!-- action: prominent mid-fight call-out (orange, bold) -->
        <Label name="$(parent)Action">
          <Dimensions x="304" y="28"/>
          <Anchor point="BOTTOM" relativeTo="$(parent)" relativePoint="BOTTOM"
                  offsetX="0" offsetY="-10"/>
        </Label>
      </Controls>

    </TopLevelControl>
  </Controls>
</GuiXml>
